diff --git a/tests/fee-headroom.test.js b/tests/fee-headroom.test.js
new file mode 100644
index 0000000..18ee8b4
--- /dev/null
+++ b/tests/fee-headroom.test.js
@@ -0,0 +1,22 @@
+import test from 'node:test';
+import assert from 'node:assert/strict';
+import { positionSizeFromUnit } from '../src/bitunix/order-units.js';
+
+const pair = { symbol: 'BTRUSDT', basePrecision: 0, quotePrecision: 5, minTradeVolume: '1', maxMarketOrderVolume: '1000000' };
+
+// position_sizing_margin_pct=100 sent the whole balance as margin, and Bitunix
+// answered "20003 Insufficient balance" because the open fee comes out of the same balance.
+test('100% margin leaves room for the open fee and the close reserve', () => {
+  const balance = 10;
+  const sized = positionSizeFromUnit({ available: balance, unit: 'cost', price: 0.065, leverage: 10, marginPct: 100, pair });
+  assert.equal(sized.ok, true);
+  const fee = sized.nominalValue * 0.0006;
+  assert.ok(sized.marginCost + fee * 2 <= balance, `margin ${sized.marginCost} + fees ${fee * 2} must fit in ${balance}`);
+  assert.ok(sized.warnings.some(w => /capped/.test(w)));
+});
+
+test('small percentages are not affected by the fee cap', () => {
+  const sized = positionSizeFromUnit({ available: 1000, unit: 'cost', price: 100, leverage: 10, marginPct: 2, pair: { ...pair, basePrecision: 3 } });
+  assert.equal(sized.qty, 2); // 20 USDT * 10 / 100
+  assert.ok(!sized.warnings.some(w => /capped/.test(w)));
+});
diff --git a/tests/liq-stop-gate.test.js b/tests/liq-stop-gate.test.js
