# LLM Settings
AI_PROVIDER=AUTO

# OpenAI-compatible (original names and requested aliases are both accepted)
OPENAI_COMPATIBLE_URL=
OPENAI_COMPATIBLE_KEY=
OPENAI_COMPATIBLE_MODEL=AUTO

# Anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_BASE_URL=
ANTHROPIC_MODEL=AUTO

# Google Gemini
GEMINI_GOOGLE_KEY=
GEMINI_GOOGLE_URL=
GEMINI_MODEL=AUTO

# Auto-select another discovered model when the current one is rate-limited.
# This is model rotation, not provider fallback.
AI_AUTO_REFRESH=1
AI_MODEL_TTL=600000

# BituniX
BITUNIX_API_KEY=
BITUNIX_API_SECRET=
BITUNIX_BASE_URL=https://fapi.bitunix.com
BITUNIX_WS_PUBLIC=wss://fapi.bitunix.com/public/
BITUNIX_WS_PRIVATE=wss://fapi.bitunix.com/private/

# Neon / any TLS database
# Keep the sslmode query parameter in this URL. The client must not hardcode its
# own ssl options, or a provider with its own CA (Neon) fails with
# DEPTH_ZERO_SELF_SIGNED_CERT and the store silently falls back to a local file
# that is wiped on every deploy.
DATABASE_URL=

# Telegram Bot
TELEGRAM_BOT_TOKEN=
ALLOWED_USER_ID=

# Agent Configuration
AGENT_NAME=J-ROCK
AGENT_AUTONOMOUS=0
AGENT_MAX_STEP=8
AGENT_THINKING_ENABLED=true
AGENT_THINKING_LEVEL=mid
AGENT_THINKING_BUDGET=5000
AGENT_AUTONOMOUS_INTERVAL_SEC=15
AGENT_AUTO_COMPACT=1

# Trader Configuration
timeframes=1m,3m,5m,15m

# AUTO_TRADE=1 makes the process start with trading authority. It is normally
# set at runtime with /autotrade on rather than here.
AUTO_TRADE=0

# Set to 1 to let /autotrade on survive a restart/redeploy. Default 0 keeps the
# safer behaviour where trading is always OFF after a restart, so a redeploy can
# never silently resume live orders.
AUTO_TRADE_PERSIST=0

# Where settings/sessions are stored when DATABASE_URL is not set. This is only
# a fallback: the store is ephemeral on most PaaS hosts, so settings are lost on
# every deploy without DATABASE_URL. With DATABASE_URL set, this directory is
# irrelevant and Postgres is the source of truth.
DATA_DIR=data
