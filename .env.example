# LLM Settings
AI_PROVIDER=AUTO

# OpenAI-compatible (original names and requested aliases are both accepted)
AI_BASE_URL=
AI_API_KEY=
AI_MODEL=AUTO
OPENAI_COMPATIBLE_URL=
OPENAI_COMPATIBLE_KEY=
OPENAI_COMPATIBLE_MODEL=AUTO

# Anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_BASE_URL=
ANTHROPIC_MODEL=AUTO

# Google Gemini
GEMINI_GOOGLE_KEY=
GEMINI_GOOGLE_URL=
GEMINI_API_KEY=
GEMINI_BASE_URL=
GEMINI_MODEL=AUTO

# Auto-select another discovered model when the current one is rate-limited.
# This is model rotation, not provider fallback.
AI_AUTO_REFRESH=1
AI_MODEL_TTL=600000

# BituniX
BITUNIX_API_KEY=
BITUNIX_API_SECRET=
BITUNIX_BASE_URL=https://fapi.bitunix.com
BITUNIX_WS_PUBLIC=wss://fapi.bitunix.com/public/
BITUNIX_WS_PRIVATE=wss://fapi.bitunix.com/private/

# Database Neon
DATABASE_URL=

# Telegram Bot
TELEGRAM_BOT_TOKEN=
ALLOWED_USER_ID=

# Agent Configuration
AGENT_NAME=J-ROCK
AGENT_AUTONOMOUS=0
AGENT_MAX_STEP=8
AGENT_THINKING_ENABLED=true
AGENT_THINKING_LEVEL=mid
AGENT_THINKING_BUDGET=5000
AGENT_AUTONOMOUS_INTERVAL_SEC=15
AGENT_AUTO_COMPACT=1

# Trader Configuration
timeframes=1m,3m,5m,15m,1h
AUTO_TRADE=0