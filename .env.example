# LLM Settings
AI_PROVIDER=AUTO

# OpenAI-compatible (original names and requested aliases are both accepted)
OPENAI_COMPATIBLE_URL=
OPENAI_COMPATIBLE_KEY=
OPENAI_COMPATIBLE_MODEL=AUTO

# Anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_BASE_URL=
ANTHROPIC_MODEL=AUTO

# Google Gemini
GEMINI_GOOGLE_KEY=
GEMINI_GOOGLE_URL=
GEMINI_MODEL=AUTO

# Auto-select another discovered model when the current one is rate-limited.
# This is model rotation, not provider fallback.
AI_AUTO_REFRESH=1
AI_MODEL_TTL=600000
# Comma-separated models to try when AUTO cannot discover one that works with
# your key. Put the model you know works with here.
AI_MODEL_FALLBACKS=

# BituniX
BITUNIX_API_KEY=
BITUNIX_API_SECRET=
BITUNIX_BASE_URL=https://fapi.bitunix.com
BITUNIX_WS_PUBLIC=wss://fapi.bitunix.com/public/
BITUNIX_WS_PRIVATE=wss://fapi.bitunix.com/private/

# Neon / any TLS database
# Keep the sslmode query parameter in this URL. The client must not hardcode its
# own ssl options, or a provider with its own CA (Neon) fails with
# DEPTH_ZERO_SELF_SIGNED_CERT and the store silently falls back to a local file
# that is wiped on every deploy.
DATABASE_URL=

# Telegram Bot
TELEGRAM_BOT_TOKEN=
ALLOWED_USER_ID=

# Agent Configuration
AGENT_NAME=J-ROCK
AGENT_AUTONOMOUS=0
AGENT_MAX_STEP=8
AGENT_THINKING_ENABLED=true
AGENT_THINKING_LEVEL=mid
AGENT_THINKING_BUDGET=5000
AGENT_AUTONOMOUS_INTERVAL_SEC=15
AGENT_AUTO_COMPACT=1

# Trader Configuration
timeframes=1m,3m,5m,15m

# Bitunix order unit — how order size is expressed.
# See https://www.bitunix.com/hub/helpcenter/article/explanation-of-the-order-units-in-futures-trading
#   nominal = contract/notional size in USDT   (cost = nominal / leverage, qty = nominal / price)
#   cost    = margin actually paid             (qty  = cost * leverage / price)
#   qty     = base-asset quantity              (nominal = qty * price, cost = qty * price / leverage)
order_unit=cost

# Which of Bitunix's four take-profit / stop-loss methods protects a position:
#   position = fixed TP/SL, whole position closes at once (all-in / all-out)
#   partial  = close the position in stages at several price levels
#   trailing = arm at an activation price, then exit on a % retrace from the peak
#   account  = close ALL positions when total account PnL crosses a threshold
# See https://www.bitunix.com/hub/helpcenter/article/bitunix-futures-position-a-guide-to-four-take-profit-and-stop-loss-methods-web?id=290
tpsl_method=position

# partial method: share of the position closed at each ladder step. The remainder
# (1 - total) keeps riding with the breakeven/trailing stop. Must not total > 1.
partial_tp_fractions=0.3,0.4,0.3
# partial method: step i triggers at this multiple of the base ATR take-profit
# distance. Must be the same length as partial_tp_fractions and strictly increasing.
partial_tp_roi_steps=1,2,3

# trailing method: retrace from the peak that exits the position (percent).
trailing_callback_pct=5

# account method: aggregate unrealised PnL thresholds in ROI percent across all
# open positions. 0 disables that side.
account_tp_roi_pct=0
account_sl_roi_pct=0

# AUTO_TRADE=1 makes the process start with trading authority. It is normally
# set at runtime with /autotrade on rather than here.
AUTO_TRADE=0

# Set to 1 to let /autotrade on survive a restart/redeploy. Default 0 keeps the
# safer behaviour where trading is always OFF after a restart, so a redeploy can
# never silently resume live orders.
AUTO_TRADE_PERSIST=0

# Telegram notifications for the position lifecycle. Without these the bot only
# reported signals, so entries and exits were silent.
#   notify_open  = announce a position as soon as it appears on the exchange
#   notify_close = announce every exit, with the reason, exit price and PnL
#   notify_tpsl  = announce break-even / trailing stop moves (chatty; off by default)
# All three are also settable at runtime: /set notify_close false
notify_open=1
notify_close=1
notify_tpsl=0

# Where settings/sessions are stored when DATABASE_URL is not set. This is only
# a fallback: the store is ephemeral on most PaaS hosts, so settings are lost on
# every deploy without DATABASE_URL. With DATABASE_URL set, this directory is
# irrelevant and Postgres is the source of truth.
DATA_DIR=data
